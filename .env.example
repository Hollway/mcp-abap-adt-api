# --- SAP connection ---------------------------------------------------------
# One server talks to one system and one client. Deploy a second server for a
# second client rather than switching this one.
SAP_URL=https://example.sap-server.com:44300
SAP_CLIENT=100
SAP_LANGUAGE=EN

# Credentials, for the stdio transport only. Over HTTP every caller sends
# their own as HTTP Basic and the server holds none of its own.
# The user variable is SAP_USER - not SAP_USERNAME.
SAP_USER=EXAMPLE_USER
SAP_PASSWORD=your_password_here

# --- Transport --------------------------------------------------------------
# stdio (default): one process per user, started by the MCP client.
# http: one process for everybody, credentials per request.
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=3000
# Largest request body. A class is sent whole when it is written, so the
# usual small JSON limit is the wrong shape of limit here.
# MCP_MAX_BODY_MB=50
# One request may take this long: an ATC run or a package activation
# legitimately takes minutes.
# MCP_REQUEST_TIMEOUT=600
# Origins allowed to reach /mcp. Unset means no check - a client that sends
# no Origin at all is the normal case.
# MCP_ALLOWED_ORIGINS=https://client.example.com

# --- Session pool (HTTP only) -----------------------------------------------
# How long an idle session with no locks is kept before it is logged off.
# SAP_SESSION_IDLE_TTL=900
# How long an idle session that still holds locks is kept. Measured from the
# last use of the STATEFUL session, not from the last request: reads travel
# on a separate stateless session and do not keep this one alive.
# Keep it comfortably under SAP_ASSUMED_SESSION_TIMEOUT, or SAP will drop the
# session before the server can release its locks deliberately.
# SAP_SESSION_IDLE_TTL_LOCKED=1680
# What the backend session timeout is assumed to be - rdisp/plugin_auto_logout
# and http/security_session_timeout, 1800 by default in SAP. Nothing reads it
# from the system; it is used to warn when the limit above is set too high.
# SAP_ASSUMED_SESSION_TIMEOUT=1800
# How many users may hold a session at once. Each costs TWO sessions on the
# backend: the stateful one and the stateless clone reads go through.
# SAP_MAX_SESSIONS=25
# How many calls may be running against SAP at once. Dialogue work processes
# are shared with everybody else on the system.
# SAP_MAX_CONCURRENT=8
# Enables GET /sessions and DELETE /sessions/<user>. Without it they are off:
# they name who is connected and what they have locked, and the delete ends
# somebody else's session.
# SAP_ADMIN_TOKEN=

# --- Guardrails and logging -------------------------------------------------
# These apply to the whole server, every caller alike.
# SAP_READONLY=1
# SAP_READONLY_ALLOW=debugger
# SAP_TOOLS_EXCLUDE=debugger,traces,atc,git
# The whole tool list costs about 158,000 characters of context before a word
# is said. A profile serves a ready-made set - min, ddic, read or dev - and
# SAP_TOOLS_INCLUDE adds groups or single tool names to it. Exclusion wins over
# both, and healthcheck is served whatever these say.
# SAP_TOOLS_PROFILE=read
# SAP_TOOLS_INCLUDE=source,package,impactOf
# SAP_MAX_RESPONSE_CHARS=200000
# LOG_LEVEL=warn
# NODE_TLS_REJECT_UNAUTHORIZED=0
